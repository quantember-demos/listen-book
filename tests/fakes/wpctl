#!/usr/bin/env bash
# Fixture: two hardware sinks plus a virtual "recorder" sink that is the default
case "$1" in
  status)
    cat <<'OUT'
PipeWire 'pipewire-0' [1.0.5, user@host, cookie:1]
 └─ Clients:
        33. WirePlumber                         [1.0.5, user@host, pid:1]

Audio
 ├─ Devices:
 │      48. Built-in Audio                      [alsa]
 │
 ├─ Sinks:
 │      52. Built-in Audio Analog Stereo        [vol: 0.40]
 │      60. HDMI / DisplayPort 1 Output         [vol: 1.00]
 │  *   70. Recorder Null Sink                  [vol: 1.00]
 │
 ├─ Sink endpoints:
 │
 ├─ Sources:
 │  *   53. Built-in Audio Analog Stereo        [vol: 1.00]
 │
 └─ Streams:

Video
 ├─ Devices:
 │
 ├─ Sinks:
 │      90. Should Not Be Listed                [vol: 1.00]
OUT
    ;;
  inspect)
    case "$2" in
      52) echo '  * node.name = "alsa_output.pci-0000_00_1b.0.analog-stereo"' ;;
      60) echo '  * node.name = "alsa_output.pci-0000_01_00.1.hdmi-stereo"' ;;
      70) echo '  * node.name = "recorder-null"' ;;
      *) exit 1 ;;
    esac
    ;;
esac
